{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Balrug apps catalog",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "apps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "apps": { "type": "array", "items": { "$ref": "#/definitions/app" } }
  },
  "definitions": {
    "text": {
      "type": "object",
      "required": ["en", "fa", "sv", "es"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "fa": { "type": "string", "minLength": 1 },
        "sv": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 }
      }
    },
    "url": { "type": "string", "pattern": "^https://" },
    "app": {
      "type": "object",
      "required": ["id", "name", "status", "category", "platforms", "icon", "tagline", "description", "links"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["live", "beta", "coming-soon", "archived"] },
        "category": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["android", "ios", "web", "windows", "macos", "linux"] }
        },
        "enabled": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 1 },
        "releasedAt": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
        "version": { "type": "string" },
        "icon": { "$ref": "#/definitions/url" },
        "cover": { "$ref": "#/definitions/url" },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "alt"],
            "additionalProperties": false,
            "properties": {
              "url": { "$ref": "#/definitions/url" },
              "alt": { "$ref": "#/definitions/text" }
            }
          }
        },
        "tagline": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "url"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["website", "repo", "play-store", "app-store", "download", "docs", "privacy", "other"] },
              "url": { "$ref": "#/definitions/url" },
              "label": { "$ref": "#/definitions/text" }
            }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "$ref": "#/definitions/text" },
              "value": { "$ref": "#/definitions/text" }
            }
          }
        }
      }
    }
  }
}
